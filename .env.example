# Polymarket Execution Configuration
# Copy this file to `.env` if configuring via env vars (or configure inside CLI Settings -> Option 6).
# Never commit `.env`.
#
# Execution modes:
#   metamask -> Zero-Key MetaMask Extension Signer (exact CLOB order signed in browser popup)
#   browser  -> Zero-Key Manual Browser Pre-Flight (opens polymarket.com event page)
#   clob     -> Direct automated CLOB signing via CLOB_PRIVATE_KEY
#
# Signature types:
#   (unset / auto) -> auto-detects EOA (0), POLY_PROXY (1), or POLY_GNOSIS_SAFE (2) from active 0x wallet
#   0 -> Direct EOA wallet (MetaMask/private key holding funds directly)
#   1 -> Polymarket Proxy wallet (Email / Magic proxy; funder = active 0x profile)
#   2 -> Polymarket Gnosis Safe (Browser/MetaMask wallet proxy; funder = active 0x profile)

# EXECUTION_MODE=metamask
# METAMASK_SIGNER=
# SIGNING_BROWSER=zen
CLOB_PRIVATE_KEY=
# CLOB_SIGNATURE_TYPE=2
# CLOB_FUNDER=
# CLOB_MAX_ORDER_USD=250.0

# Optional: if omitted, API key/secret/passphrase are derived automatically
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=
