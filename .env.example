# Polymarket CLOB Live Execution Configuration
# Copy this file to `.env` and fill in your signing key (never commit `.env`).
#
# Signature types:
#   (unset / auto) -> auto-detects EOA (0), POLY_PROXY (1), or POLY_GNOSIS_SAFE (2) from active 0x wallet
#   0 -> Direct EOA wallet (MetaMask/private key holding funds directly)
#   1 -> Polymarket Proxy wallet (Email / Magic login; funder = active 0x profile)
#   2 -> Polymarket Gnosis Safe (Browser wallet proxy; funder = active 0x profile)

CLOB_PRIVATE_KEY=
# CLOB_SIGNATURE_TYPE=1
# CLOB_FUNDER=
# CLOB_MAX_ORDER_USD=250.0

# Optional: if omitted, API key/secret/passphrase are derived automatically from CLOB_PRIVATE_KEY
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=
